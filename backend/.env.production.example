# CheckStart AI - Backend Production Environment Variables
APP_NAME="CheckStart AI Validation API"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Database Connection (PostgreSQL on Render or Supabase/Neon)
DATABASE_URL="postgresql://username:password@hostname:5432/checkstart_prod"

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production CORS (Comma-separated Vercel frontend URLs)
CORS_ORIGINS="https://checkstart-ai.vercel.app,https://your-custom-domain.com"

# Generative AI Configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY="REPLACE_WITH_YOUR_PRODUCTION_GEMINI_API_KEY"

# Vector Embedding Configuration
EMBEDDING_MODEL="all-MiniLM-L6-v2"
SIMILARITY_THRESHOLD=0.85
SIMILARITY_HIGH_THRESHOLD=0.85
SIMILARITY_MED_THRESHOLD=0.72
SIMILARITY_MIN_IDEAS_FOR_FLAG=1

# Execution Mode
CELERY_TASK_ALWAYS_EAGER=1
REDIS_REQUIRED=False
# REDIS_URL="redis://localhost:6379/0" # Uncomment only if Redis add-on is provisioned
